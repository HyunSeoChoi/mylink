rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/links/{linkId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/profile/{profileId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
